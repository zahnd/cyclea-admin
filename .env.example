# Copy to .env.local and fill in. Never commit the filled copy.
#
# NAMING RULE: no NEXT_PUBLIC_ variable may describe the Cyclea App project.
# A NEXT_PUBLIC_ prefix ships the value to every visitor's browser, and the app
# project holds health data. See docs/architecture.md § The credential boundary.

# --- Cyclea Admin PROD (mtcnwjpjbupsbkbhqbph) -------------------------------
# This project's own data: payouts, rates, audit log, admin and creator logins.
# URL and anon key are public by design; RLS is what protects them.
NEXT_PUBLIC_SUPABASE_URL=https://mtcnwjpjbupsbkbhqbph.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS within the admin project. Reaches no app data.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cyclea App PROD (zekaahjqdynuhjmgkpqf), read through one view ----------
# The `admin_portal` role's pooler connection string. NOT a service-role key,
# and not a role that inherits one. Copy the host from the app project's
# dashboard (Connect → Connection pooling) and substitute the role and password:
#
#   postgresql://admin_portal.zekaahjqdynuhjmgkpqf:<password>@aws-1-eu-central-2.pooler.supabase.com:5432/postgres
#
# Port 5432 on the POOLER host is session mode, which is what a persistent
# Node server wants. 6543 is transaction mode, for serverless. Note the
# username is the ROLE plus the project ref -- the dashboard shows
# `postgres.<ref>` because it assumes the superuser.
#
# Grants: SELECT on public.creator_revenue_events, and INSERT/UPDATE on
# public.creators. Nothing else. See docs/setup.md before assuming this works —
# custom roles through the pooler is the one thing to verify first.
CYCLEA_APP_DATABASE_URL=
