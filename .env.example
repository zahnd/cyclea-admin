# Copy to .env.local and fill in. Never commit the filled copy.
#
# NAMING RULE: no NEXT_PUBLIC_ variables at all. A NEXT_PUBLIC_ prefix ships
# the value to every visitor's browser; every Supabase call here runs on the
# server, so nothing needs one -- and for the Cyclea App project, which holds
# health data, it would be a breach. See docs/architecture.md.

# --- Cyclea Admin PROD (mtcnwjpjbupsbkbhqbph) -------------------------------
# This project's own data: payouts, rates, audit log, admin and creator logins.
# URL and publishable key (sb_publishable_...) are public by design; RLS is
# what protects them. Used for sign-in and the user's own session.
SUPABASE_URL=https://mtcnwjpjbupsbkbhqbph.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_KGmO8NsmXrFVkYnFq9worQ_vrKfQZek

# Secret key (sb_secret_..., role service_role). Bypasses RLS within the admin
# project; reaches no app data. Admin project -> Settings -> API Keys.
SUPABASE_SECRET_KEY=

# --- Cyclea App PROD (zekaahjqdynuhjmgkpqf), read through one view ----------
# The `admin_portal` role's pooler connection string. NOT a service-role key,
# and not a role that inherits one. Copy the host from the app project's
# dashboard (Connect → Connection pooling) and substitute the role and password:
#
#   postgresql://admin_portal.zekaahjqdynuhjmgkpqf:<password>@aws-1-eu-central-2.pooler.supabase.com:5432/postgres
#
# Port 5432 on the POOLER host is session mode, which is what a persistent
# Node server wants. 6543 is transaction mode, for serverless. Note the
# username is the ROLE plus the project ref -- the dashboard shows
# `postgres.<ref>` because it assumes the superuser.
#
# Grants: SELECT on public.creator_revenue_events, and SELECT/INSERT/UPDATE on
# public.creators. Nothing else. TLS is verified against the app project's CA
# certificate in lib/db/supabase-ca.crt -- see docs/setup.md.
CYCLEA_APP_DATABASE_URL=
